# ---- VayuSangam environment template -------------------------------------
# Copy to .env and fill in. .env is git-ignored; NEVER commit real values.

# --- Air quality: OpenAQ v3 ----------------------------------------------
# Account: https://explore.openaq.org/register  (or https://openaq.org)
# Key is passed as the X-API-Key request header; it is never written to a log
# or to any file under data/.
OPENAQ_API_KEY=
# Inclusive collection window (YYYY-MM-DD). Blank end = today.
OPENAQ_START_DATE=2024-01-01
OPENAQ_END_DATE=
# WGS84 bbox as west,south,east,north. NCR plus adjacent NW source regions.
OPENAQ_BBOX=74.0,26.0,80.0,32.5
OPENAQ_LOG_LEVEL=INFO

# --- Fire detections: NASA FIRMS -----------------------------------------
# Account/API key: https://firms.modaps.eosdis.nasa.gov/api/ -> "map_key"
# The key is embedded in the request path, so it is passed via the environment
# and stripped from any URL written to disk or logs.
FIRMS_MAP_KEY=
# Region as west,south,east,north for the FIRMS "area" endpoint.
FIRMS_BBOX=73.0,26.5,80.5,32.5

# --- Meteorology: Open-Meteo ---------------------------------------------
# No API key required.
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com
OPEN_METEO_LAT=28.6139
OPEN_METEO_LON=77.2090

# --- Copernicus (ERA5 via CDS, CAMS via ADS) -----------------------------
# Since the 2025 CDS/ADS migration, credentials live in ~/.cdsapirc and are
# NOT read from this project .env by cdsapi. The file must contain ONLY
#   url: https://cds.climate.copernicus.eu/api      (ERA5)
#   key: <PERSONAL-ACCESS-TOKEN>
# For CAMS use url: https://ads.atmosphere.copernicus.eu/api
# No `uid:` field any more. Requires cdsapi>=0.7.7.
# These vars are only used to *check* whether ~/.cdsapirc exists and which
# host it points at; the token itself is never read into this project.
CDSAPI_CONFIG=~/.cdsapirc
CAMS_API_KEY=
ERA5_API_KEY=

# --- Application ---------------------------------------------------------
DATABASE_URL=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
VAYUSANGAM_MODE=REPLAY
